# Indexer — copy to .env (never commit real secrets)
DATABASE_URL=postgres://backstop:backstop@localhost:5432/backstop
REDIS_URL=redis://localhost:6379
# Helius RPC (devnet/mainnet) or local validator
RPC_URL=http://127.0.0.1:8899
# Shared secret configured on the Helius webhook (Authorization header)
HELIUS_WEBHOOK_SECRET=
INDEXER_PORT=8788
POLL_INTERVAL_MS=4000
POLLER_ENABLED=true
LOG_LEVEL=info
