{
  "name": "@backstop/indexer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "start": "node dist/main.js",
    "replay": "node dist/replay.js",
    "migrate": "node dist/migrate.js"
  },
  "dependencies": {
    "@backstop/sdk": "workspace:*",
    "@solana/web3.js": "1.99.0",
    "fastify": "^5.6.1",
    "ioredis": "^5.8.2",
    "pg": "^8.16.3",
    "pino": "^9.13.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.5",
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  }
}
