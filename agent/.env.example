# BACKSTOP AI treasury agent — copy to .env and fill in. Never commit secrets.

# Anthropic API. The SDK also accepts ANTHROPIC_AUTH_TOKEN or an `ant auth login` profile.
ANTHROPIC_API_KEY=
# Default model; governance can pin another one here.
AGENT_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max (Opus 5.5 defaults to medium; treasury work runs at high)
AGENT_EFFORT=high

RPC_URL=http://127.0.0.1:8899
DATABASE_URL=postgres://backstop:backstop@localhost:5432/backstop
# Agent hot key: path to a JSON keypair file or base58 secret. Must equal AgentAuthority.agent on-chain.
AGENT_KEYPAIR=
# JSON array of markets: [{"mint":"...","quoteDecimals":6,"quoteSymbol":"USDC"}]
MARKETS=[]

# Seconds between cycles (narration + proposals). On-chain cooldown per parameter is separate (1 h).
RUN_INTERVAL_SECS=21600
# true → never send transactions; proposals are recorded with status "dry_run".
DRY_RUN=true
# Max on-chain parameter updates per market per cycle.
MAX_ACTIONS_PER_RUN=2
# Max move per update as a fraction of the governance [min,max] window, in bps (2500 = 25 %).
MAX_STEP_BPS=2500

# X (Twitter) posting — feature-flagged, off by default.
X_ENABLED=false
# OAuth 2.0 user-context access token with tweet.write scope (obtained out of band).
X_ACCESS_TOKEN=
X_API_URL=https://api.x.com/2/tweets
# Optional suffix appended to X posts (e.g. a link to the in-app feed).
X_POST_SUFFIX=

# Optional webhook notified when a proposal needs governance (out of bounds / not agent-tunable).
GOVERNANCE_WEBHOOK_URL=
HEALTH_PORT=8791
LOG_LEVEL=info
