# BACKSTOP web app configuration. All values are inlined at build time.

# Read API (see api/). REST under /v1, WebSocket at /v1/ws.
NEXT_PUBLIC_API_URL=http://localhost:8787

# Solana JSON-RPC endpoint used for balances and sending transactions.
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8899

# localnet | devnet | mainnet-beta (explorer links and wallet chain).
NEXT_PUBLIC_CLUSTER=localnet

# BACKSTOP engine mint (Token-2022, 9 decimals).
NEXT_PUBLIC_MINT=

# Quote mint of the BACKSTOP market (USDC, 6 decimals).
NEXT_PUBLIC_QUOTE_MINT=

# Optional: SOL/USD reference price endpoint (Jupiter Price API v3 shape) used
# only to draw the treasury floor on the USDC price chart. Leave empty to hide
# the floor line from the chart (the floor in SOL is still shown).
NEXT_PUBLIC_SOL_PRICE_URL=https://lite-api.jup.ag/price/v3?ids=So11111111111111111111111111111111111111112
