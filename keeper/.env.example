# Keeper — copy to .env. KEEPER_KEYPAIR must point to a funded hot key that is
# set as `keeper` on each market (fee conversions). Never commit it.
RPC_URL=http://127.0.0.1:8899
DATABASE_URL=postgres://backstop:backstop@localhost:5432/backstop
KEEPER_KEYPAIR=/run/secrets/keeper.json
# JSON array: [{"mint":"...","quoteMint":"...","adapterAccounts":[{"pubkey":"...","writable":true}]}]
MARKETS=[]
ALERT_WEBHOOK_URL=
DASHBOARD_PORT=8790
JUPITER_ENABLED=false
JUPITER_URL=https://lite-api.jup.ag/swap/v1
SWAP_SLIPPAGE_BPS=50
DISTRIBUTE_MIN=1000000
CONVERT_MIN=10000000
# Pending redemption-fee lamports before converting to Shield rewards (0.1 SOL)
SHIELD_CONVERT_MIN_LAMPORTS=100000000
CHUNK_INTERVAL_SECS=120
PRIORITY_FEE_MICROLAMPORTS=10000
LOG_LEVEL=info
